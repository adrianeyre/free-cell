{
	"name": "free-cell",
	"version": "1.0.0",
	"private": false,
	"description": "FreeCell Game — a remake of the classic solitaire card game, written in TypeScript on a 2D canvas",
	"keywords": [
		"freecell",
		"free-cell",
		"solitaire",
		"cards",
		"game",
		"typescript",
		"canvas"
	],
	"license": "ISC",
	"author": "Adrian Eyre",
	"repository": {
		"type": "git",
		"url": "https://github.com/adrianeyre/free-cell.git"
	},
	"bugs": {
		"url": "https://github.com/adrianeyre/free-cell/issues"
	},
	"homepage": "https://github.com/adrianeyre/free-cell#readme",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"serve": "vite preview --host --port 4173",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,md}\" \"index.html\" \".github/**/*.yml\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,md}\" \"index.html\" \".github/**/*.yml\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"semantic-release": "semantic-release"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/node": "^26.5.0",
		"@vitest/coverage-v8": "^5.0.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^10.10.0",
		"prettier": "^3.9.6",
		"semantic-release": "^25.0.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
